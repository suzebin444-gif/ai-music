# DeepSeek — https://platform.deepseek.com/api_keys
# 用于情绪推荐、体验报告 AI 摘要、智能助手「小斌」（写入 .env.local）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# 社交媒体（页脚链接，填你的官方主页）
NEXT_PUBLIC_DOUYIN_URL=https://www.douyin.com/user/your_account
NEXT_PUBLIC_XIAOHONGSHU_URL=https://www.xiaohongshu.com/user/profile/your_account
NEXT_PUBLIC_WECHAT_URL=
NEXT_PUBLIC_WECHAT_NAME=SQMUSIC
NEXT_PUBLIC_WECHAT_QR_URL=

# Spotify — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Netease Cloud Music API (optional) — https://github.com/Binaryify/NeteaseCloudMusicApi
# 未配置时场景搜索会自动使用网易云 Web 接口；配置本地 API 可提升稳定性
NETEASE_API_URL=http://localhost:3001
